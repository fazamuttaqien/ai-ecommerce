NODE_ENV=development
PORT=8000

POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DATABASE=ai-ecommerce-db
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/ai-ecommerce-db?schema=public

JWT_SECRET=<JWT_SECRET>
JWT_EXPIRES_IN=7d

STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

FRONTEND_ORIGIN=http://localhost:5173

AI_ENABLED=true
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=<GROQ_API_KEY>

GEMINI_API_KEY=<GEMINI_API_KEY>

# Hybrid Product Search
HYBRID_SEARCH_KEYWORD_WEIGHT=0.5
HYBRID_SEARCH_SEMANTIC_WEIGHT=0.5
HYBRID_SEARCH_CANDIDATE_LIMIT=50
